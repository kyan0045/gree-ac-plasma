# Maintainer: kyan0045 <https://github.com/kyan0045>
_pkgname=gree-ac-plasma
pkgname=gree-ac-plasma-git
pkgver=0.1.0.r3.ge1f30ba
pkgrel=1
pkgdesc="Rust controller daemon and native Plasma 6 applet for Gree air conditioners"
arch=('x86_64' 'aarch64')
url="https://github.com/kyan0045/gree-ac-plasma"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'kirigami' 'libplasma' 'plasma5support')
optdepends=('networkmanager: Wi-Fi SSID detection for the HOME/AWAY badge')
makedepends=('cargo' 'git')
provides=('gree-ac-plasma')
conflicts=('gree-ac-plasma')
install=gree-ac-plasma-git.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  local ver
  ver=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -n1)
  printf "%s.r%s.g%s" \
    "$ver" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$srcdir/$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$srcdir/$_pkgname"
  make install DESTDIR="$pkgdir" PREFIX=/usr LICENSE_DIR="/usr/share/licenses/$pkgname"
}
