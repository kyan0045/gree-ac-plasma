post_install() {
  cat <<'EOF'
==> To enable and start the Gree AC daemon for your user:
    systemctl --user daemon-reload
    systemctl --user enable --now gree-ac-plasma.service
==> Then right-click your Plasma panel -> "Add or manage widgets" -> "Gree AC".
EOF
}

post_upgrade() {
  cat <<'EOF'
==> Reload and restart the Gree AC daemon if running:
    systemctl --user daemon-reload
    systemctl --user try-restart gree-ac-plasma.service
==> If the Plasma widget QML changed, restart plasmashell or log out and back in.
EOF
}
